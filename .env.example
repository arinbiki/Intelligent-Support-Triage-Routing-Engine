# Environment Variables Example for Support Triage & Routing Engine
# Copy this file to .env and insert your real tokens. NEVER commit .env to version control!

# Windmill Configuration
WINDMILL_BASE_URL=http://localhost:8080
WINDMILL_WORKSPACE=demo
WINDMILL_TOKEN=your_windmill_api_token_here

# n8n Configuration
N8N_BASE_URL=https://your-n8n-instance.cloud
N8N_API_KEY=your_n8n_api_key_here
N8N_SENSOR_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/support-ticket-ingress
N8N_TOOL_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/helpdesk-tool-executor

# Helpdesk API Credentials (Zendesk / Gorgias)
HELPDESK_PROVIDER=zendesk
ZENDESK_SUBDOMAIN=your-store
ZENDESK_ADMIN_EMAIL=admin@yourstore.com
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# Slack Notifications
SLACK_ESCALATIONS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

